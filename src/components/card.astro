---
interface Props {
    title: string;
    body: string;
    theme: 'primary' | 'secondary' | 'tertiary';
    hasBtn?: boolean;
    btnText?: string;
    btnLink?: string;
}
const { title, body, theme, hasBtn, btnText, btnLink } = Astro.props;
const themeClass = theme === 'primary' ? 'standard-card' : `card--${theme}`;
---
<div class:list={[
    themeClass,
    { 'standard-card--secondary': theme === 'secondary' },
    { 'standard-card--tertiary': theme === 'tertiary' },
]}>
    <h2 
    class="'standard-card__heading">{title}</h2>
    <p class="'standard-card__body">{body}</p>
    {hasBtn && <a href={btnLink} class="standard-card__btn">{btnText}</a>}
</div>
---