---
import Container from "../container.astro";
import Nav from './nav.astro';


// image stuff 
import Image from "astro/components/Image.astro";
import brand from "../../media/brand/logo-dark.svg"
---
<header class="site-header">
    <Container width="standard">
        <div class="site-header__inner">
            <a href="/"><figure class="site-header__brand">
                <Image src={brand} alt="My Logo. My name in Orange with my last name bolded" title="Click to go home"/>
            </figure></a>
            <!-- Checkbox for mobile navigation  -->
                 <input type="checkbox" class="site-header__nav-toggle" id="nav-toggle"  />
                               <label for="nav-toggle" aria-expanded="false" class="site-header__nav-toggle-label" aria-label="toggle the mobile menu" id="openModalButton">
                               <span></span>
                               <span></span>
                               <span></span>
                              </label>
            <Nav />
        </div>
    </Container>
</header>
<script>
   const checkbox = document.querySelector('input[type="checkbox"]');
checkbox.addEventListener('change', function() {
  if (this.checked) {
    this.nextElementSibling.setAttribute('aria-expanded', 'true');
  } else {
    this.this.nextElementSibling.setAttribute('aria-label', 'Open navigation');
  }
});
</script>