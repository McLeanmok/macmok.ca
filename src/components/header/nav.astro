---
import NavData from "../../loops/nav.json";
import NavLink from "./nav-link.astro"; 
---
<nav class="site-header__nav">
    <ul class="site-header__nav-links" id="nav">
        {
            NavData.map((link) => (
                <li class="site-header__nav-link">
                    <NavLink navLink={link} />
                </li>
            ))
        }
    </ul>
</nav>

<script>

  const navLinks = document.querySelectorAll('nav a');

  if (navLinks.length > 0) {
    document.addEventListener('DOMContentLoaded', () => {
      navLinks.forEach((link) => {
        const linkUrl = link.href.trim();
        const currentPageUrl = window.location.href.trim();
        const currentPageHash = currentPageUrl.split('#').pop();
        const linkHash = linkUrl.split('#').pop();

        if (linkUrl === currentPageUrl || (linkHash && linkHash === currentPageHash)) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    });
  }
</script>