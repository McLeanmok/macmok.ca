---
import Container from "../container.astro";
import Input from "../input.astro";
import SiteForm from "../site-form.astro";
---

<section class="contact-alpha">
    <Container width="narrow" smartSpacing customClass="contact-alpha__inner">

        <!-- top -->
         <div class="contact-alpha__content" data-smart-spacing>
            <h2 class="contact-alpha__heading">Let's Chat</h2>
            <p class="contact-alpha__body">To connect, please fill out the form below. I look forward to hearing from you and will respond in a timely manner..</p>
         </div>
        <!--Contact Form -->
       <SiteForm />
    </Container>
</section>