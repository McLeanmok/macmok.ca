---
// dynamic tag changing 
import type { Polymorphic} from "astro/types";
type Props<Tag extends "a" |"button"> = Polymorphic<{as: Tag}> &  {
    text: string;
    title?: string;
    href?: string;
    theme: "primary" | "secondary" | "tertiary" | "neutral"| "neutral-light";
    outline?: boolean;
    customClasses?: string;
}
// exporting props
const {as: Tag = "a", text, href, theme, customClasses, outline, title, ...rest } = Astro.props;
const themeClass = outline ? `btn-outline__${theme}` : (theme === "primary" ? "standard-btn" : `standard-btn--${theme}`);
---
<Tag 
 href={href}
 title={title}
 clTagss:list={[
    themeClass,
    { "button--filled": outline },
    customClasses,
 ]},
 {...rest}
>
    {text}
</Tag>