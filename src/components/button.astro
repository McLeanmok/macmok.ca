---
interface Props {
    text: string;
    href: string;
    theme: "primary" | "secondary" | "tertiary" | "neutral";
    filled?: boolean;
    customClasses?: string;
}
const { text, href, theme, customClasses, filled, ...rest } = Astro.props;
const themeClass = theme === "primary" ? "standard-btn" : `standard-btn--${theme}`;
---
<a 
 href={href}
 class:list={[
    themeClass,
    { "button--filled": filled },
    customClasses,
 ]},
 {...rest}
>
    {text}
</a>