---
interface Props {
    text: string;
    href: string;
    theme: "primary" | "secondary" | "tertiary" | "neutral";
    outline?: boolean;
    customClasses?: string;
}
const { text, href, theme, customClasses, outline, ...rest } = Astro.props;
const themeClass = outline ? `btn-outline__${theme}` : (theme === "primary" ? "standard-btn" : `standard-btn--${theme}`);
---
<a 
 href={href}
 class:list={[
    themeClass,
    { "button--filled": outline },
    customClasses,
 ]},
 {...rest}
>
    {text}
</a>