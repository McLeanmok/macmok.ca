---
import socialData from "../loops/socials.json";
const { social } = Astro.props;
import {Icon} from "astro-icon/components"
---

<ul class="social-menu" aria-label="My Socials">
    {
        socialData.map((link) => {
            return (
                <li class="social-menu__item">
                    <a href={link.url} class="social-menu__link" target="_blank">
                        <Icon name={link.href} class="social-menu__icon"/>
                    </a>
                </li>
            )
        })
    }
</ul>
