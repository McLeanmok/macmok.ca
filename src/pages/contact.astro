---
import MainTemplate from "../templates/main-template.astro";
import Container from "../components/container.astro";
import ContactAlpha from "../components/frames/contact-alpha.astro";

// Loops
import methods from "../loops/contact-methods.json"
import { Icon } from "astro-icon/components";
---

<MainTemplate title="McLean Mylymok | Contact" description="If you want get in touch with me, you can do so here. I would love to hear from you, and hear about your projects. " noCta author="McLean Mylymok" keywords={[
    "Contact",
    "Get in touch",
    "Contact McLean Mylymok",
    "Media Producer Contact",
    " McLean Mylymok",
    "Mac Mylymok",
    "McLean Mylymok contact",
    "Reach out to McLean Mylymok",
]} >
    <section class="content-hardy">
        <Container width ="standard" smartSpacing customClass="content-hardy__inner" >
            <h1 class="content-hardy__seo-heading">Contact Me</h1>
            <span class="content-hardy__heading">Let's Get This Conversation Started..</span>
            <p class="content-hardy__body">I would love to work with you. If you have questions, or simply want to start a conversation, I’d be happy to hear from you. Whether it is a project inquiry, a request for information, or general feedback, please feel free to reach out using the form below. Your message matters to me, and I look forward to learning more about how I can engage with you.</p>
        </Container>
    </section>

    <ContactAlpha />

    <!-- methods  -->
     <section class="methods">
        <Container width="standard" customClass="methods__inner">
            <h2 class="methods__heading">Other Ways You Can Reach Meee!</h2>
            <ul class="methods__list">
                {
                    methods.map((m) => (
                        <li>
                            <article class="icon-card">
                                <h3 class="icon-card__heading">{m.title}</h3>
                                <p class="icon-card__body">{m.detail}</p>
                                <figure class="icon-card__icon-wrapper">
                                    <Icon name={m.icon.src} alt={m.icon.alt} title={m.icon.alt} width={35} height={35}/>
                                </figure>

                            </article>
                        </li>
                    ))
                }
            </ul>
        </Container>
     </section>
</MainTemplate>