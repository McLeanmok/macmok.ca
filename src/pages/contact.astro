---
import MainTemplate from "../templates/main-template.astro";
import Container from "../components/container.astro";
import ContactAlpha from "../components/frames/contact-alpha.astro";
import { imageConfig } from "astro:assets";

// Loops
import methods from "../loops/contact-methods.json"
import { Image } from "astro:assets";
---

<MainTemplate title="McLean Mylymok | Contact" description="If you want get in touch with me, you can do so here. I would love to hear from you, and hear about your projects. " noContact author="McLean Mylymok" keywords={[
    "Contact",
    "Get in touch",
    "Contact McLean Mylymok",
    "Media Producer Contact",
    " McLean Mylymok",
    "Mac Mylymok",
    "McLean Mylymok contact",
    "Reach out to McLean Mylymok",
]} >
    <section class="contact-hero">
        <Container width ="standard" smartSpacing customClass="contact-hero__inner" >
            <h1 class="contact-hero__heading">Let's Get This Conversation Started (I Will Yap Your Ear Off).</h1>
            <p class="contact-hero__body">– If you’re interested in working together, have questions, or simply want to start a conversation, I’d be happy to hear from you. Whether it’s a project inquiry, a request for information, or general feedback, feel free to reach out using the form below. Your message matters, and I look forward to learning more about how I can assist or engage with you.</p>
        </Container>
    </section>

    <ContactAlpha />

    <!-- methods  -->
     <section class="methods">
        <Container width="standard" customClass="methods__inner">
            <h2 class="methods__heading">Other Ways You Can Reach Me</h2>
            <div class="methods__list">
                {
                    methods.map((m) => (
                        <li>
                            <article class="icon-card">
                                <h3 class="icon-card__heading">{m.title}</h3>
                                <p class="icon-card__body">{m.detail}</p>
                                <figure class="icon-card__icon-wrapper">
                                    <Image src={m.icon.src} alt={m.icon.alt} title={m.icon.alt} width={35} height={35}/>
                                </figure>
                            </article>
                        </li>
                    ))
                }
            </div>
        </Container>
     </section>
</MainTemplate>