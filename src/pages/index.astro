---
import MainTemplate from "../templates/main-template.astro";
import Button from "../components/button.astro";
import Container from "../components/container.astro";

// image stuff
import Image from "astro/components/Image.astro";
import { Icon } from "astro-icon/components";
import hero from "../media/index/hero.jpg"
import about from "../media/index/about.webp"
import Work from "../media/index/work.webp"

// Loops
import skills from "../loops/services.json";
import ContactAlpha from "../components/frames/contact-alpha.astro";
---
 
<MainTemplate title="McLean Mylymok | Home" description="Welcome to my personal website! I'm McLean Mylymok, a media producer based in Parksville, BC. Explore my projects, blog posts, and get in touch with me." author="McLean Mylymok" keywords={[
	"Home",
	"main page",
	"introdction",
	"Mclean",
	"Mac",
	"Mclean Mylymok",
	"Mac Mylymok"
]} >
	<!-- Hero section -->
	 <section class="home-hero">
		<Container width="standard" customClass="home-hero__inner">
			<div class="home-hero__content">
				<h1 class="home-hero__heading">A Music Loving, Humorous, and Hard Working Media Producer</h1>
				<p class="home-hero__body">I am a media student at Vancouver Island University with a strong passion for crafting narrative and solving problems through a variety of digital formats. My interests include music, skiing, adventuring, and media production. On this website you can find out more about me and my projects, while exploring created content around media and music. </p>
				<div class="button-row">
					<Button theme="primary" text="About Me" href="/about" />
					<Button theme="secondary" text="Get In Touch" href="/contact" outline customClasses="btn-radius__standard"/>
				</div>
			</div> <!-- end hero content -->
			<figure class="home-hero__media-wrapper">
				<Image src={hero}  class="home-hero__media" alt="a headshot of me taken at the North Island Wildlife Recreational Area Center in Errington, BC" title="A picture of me at the North Island Wildlife Recovery Center" format="webp" />
			</figure>
		</Container>
	 </section>

	 <!-- About section ( using the content section Kelowna frame) -->
	  <section class="content-kelowna">
		  <Container width="standard" smartSpacing>
			<h2 class="content-kelowna__heading">A Little Bit About Me</h2>
			<div class="content-kelowna__grid">
				<div class="content-kelowna__content">
					<p class="hero-kelowna__body">My passion is digital media. While I am very confident in working with web-based media, I am also enthusiastic about photography, and audio production. Outside of media, my primary passion is music. I listen to various genres, and love when I am introduced to something I have never heard before.  I continually strive to explore a wider range of content. I value music that comes across as authentic and has a unique quality to it.</p>
					<Button theme="primary" href="/about" text="Get to Know Me Better"/>
				</div> <!-- end about content -->
				<figure class="content-kelowna__media-wrapper">
					<Image src={about} class="content-kelowna__media" alt="me at the Sidney pier" title="A picture of me at the Sidney pier takeen April 20th, 2024" />
				</figure>
			</div>
		  </Container>
	  </section>

	  
	    <!-- Work  section ( using the content section Kelowna frame) -->
	   <section class="content-kelowna">
		  <Container width="standard" smartSpacing>
			<h2 class="content-kelowna__heading">Why You Should Work With Me</h2>
			<div class="content-kelowna__grid">
				<div class="content-kelowna__content">
					<p class="hero-kelowna__body">I am very hard working, planning and organizing in a way that allows me to get all my projects done on time, without procrastination. The quality of my work is very high. When constructing a project, my main goal is to ensure that the message resonates with the intended audience. You could have a pretty looking website, or an amazingly produced podcast, but if the content is not up to standard, it is a failure. My aim is for high quality productions as the end result, every time.</p>
				</div> <!-- end about content -->
				<figure class="content-kelowna__media-wrapper">
					<Image src={Work} class="content-kelowna__media" alt="me doing some digital audio production on my eyegaze. It's my first day of work at 101.7 CHLY fm" title="Me on my first day of work at 101.7 CHLY fm" />
				</figure>
			</div>
		  </Container>
	  </section> 


	<!-- skills  -->
	 <section class="skills">
		<Container width="standard" smartSpacing customClass="skills__inner">
			<h2 class="skills__heading">My Skills</h2>
			<ul class="skills__grid">
				{skills.map((skill) => (
					<li>
						<article class="icon-card">
							<h3 class="icon-card__heading">{skill.title}</h3>
							<p class="icon-card__body">{skill.body}</p>
							<div class="icon-card__icon-wrapper">
								<Icon name={skill.icon.src} title={skill.icon.alt}class="icon-card__icon" />
							</div>
							
						</article>
					</li>
				))}
			</ul>
			<Button theme="primary" href="/services" text="Learn More About What I Can Do" customClasses="skills__action"/>
		</Container>
	 </section>
	 
	 <ContactAlpha />
</MainTemplate>