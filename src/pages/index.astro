---
import MainTemplate from "../templates/main-template.astro";
import Button from "../components/button.astro";
import Container from "../components/container.astro";
import Card from "../components/card.astro";

// image stuff
import Image from "astro/components/Image.astro";
import hero from "../media/index/hero.jpg"
import about from "../media/index/about.webp"
import Work from "../media/index/work.webp"

// Loops
import skills from "../loops/services.json";
---
 
<MainTemplate title="McLean Mylymok | Home" description="Welcome to my personal website! I'm McLean Mylymok, a media producer based in Parksville, BC. Explore my projects, blog posts, and get in touch with me." >
	<!-- Hero section -->
	 <section class="home-hero">
		<Container width="standard" customClass="home-hero__inner">
			<div class="home-hero__content">
				<h1 class="home-hero__heading">A Music Loving, Humorous, and Hard Working Media Producer</h1>
				<p class="home-hero__body">Hello, my name is McLean Mylymok, and I’m a media student at Vancouver Island University. I have a strong passion for digital media. I am a well-rounded individual, who’s interested in many things. On this website, you can find out more about me and my projects, and find lots of content around media, and music. </p>
				<div class="button-row">
					<Button theme="primary" text="About Me" href="/about" />
					<Button theme="primary" text="Get In Touch" href="/contact" outline customClasses="btn-radius__standard"/>
				</div>
			</div> <!-- end hero content -->
			<figure class="home-hero__media-wrapper">
				<Image src={hero}  class="home-hero__media" alt="a headshot of me taken at the North Island Wildlife Recreational Area Center in Errington, BC" title="A picture of me at the North Island Wildlife Recovery Center" format="webp" />
			</figure>
		</Container>
	 </section>

	 <!-- About section ( using the content section Kelowna frame) -->
	  <section class="content-kelowna">
		  <Container width="standard" smartSpacing>
			<h2 class="content-kelowna__heading">About Me</h2>
			<div class="content-kelowna__grid">
				<div class="content-kelowna__content">
					<p class="hero-kelowna__body"> I am passionate about Digital media. My main medium is web, but I am comfortable with photography, and audio design. Outside of media, my primary passion is music. I listen to various genres, and I’m open to most music. I should warn you however, if you play Taylor Swift, things won’t go well.</p>
					<Button theme="primary" href="/about" text="Get to Know Me Better"/>
				</div> <!-- end about content -->
				<figure class="content-kelowna__media-wrapper">
					<Image src={about} class="content-kelowna__media" alt="me at the Sidney pier" title="A picture of me at the Sidney pier takeen April 20th, 2024" />
				</figure>
			</div>
		  </Container>
	  </section>

	  <!-- Audience  -->
	   <section class="audience">
		  <Container width="standard" smartSpacing>
			<h2 class="audience__heading">Who's This Site For?</h2>

			<div class="audience__grid">
				<Card title="For Those of you Who Want to Work With Me" body="If you wish to work with me, you’re in the right place. You are able to view my portfolio and find out about my personality. I can either take on individual projects or work for your business" theme="primary" />
				<Card title=" For Those of You Who Are Creative" body="If you call yourself the creative type, you are in luck. You are able to download my media resources absolutely free of charge. Aside from the templates, you will be able to find many of blog posts that cover everything from media to music reviews"  theme="primary"/>
			<!-- </div> end of audience grid -->
		  </Container>
	   </section>

	    <!-- Work  section ( using the content section Kelowna frame) -->
	   <section class="content-kelowna">
		  <Container width="standard" smartSpacing>
			<h2 class="content-kelowna__heading">Why You Should Work With Me</h2>
			<div class="content-kelowna__grid">
				<div class="content-kelowna__content">
					<p class="hero-kelowna__body">I am really hard working. I get all my projects done on time, and I do not procrastinate. The quality of my work is very high. I put all my effort in. All of my projects look good. I pay special attention to design and detail.</p>
				</div> <!-- end about content -->
				<figure class="content-kelowna__media-wrapper">
					<Image src={Work} class="content-kelowna__media" alt="me doing some digital audio production on my eyegaze. It's my first day of work at 101.7 CHLY fm" title="Me on my first day of work at 101.7 CHLY fm" />
				</figure>
			</div>
		  </Container>
	  </section> 


	<!-- skills  -->
	 <section class="skills">
		<Container width="standard" smartSpacing customClass="skills__inner">
			<h2 class="skills__heading">My Skills</h2>
			<ul class="skills__grid">
				{skills.map((skill) => (
					<li>
						<article class="icon-card">
							<h3 class="icon-card__heading">{skill.title}</h3>
							<p class="icon-card__body">{skill.body}</p>
							<figure class="icon-card__icon-wrapper">
								<img src={skill.icon.src} alt={skill.icon.alt} title={skill.icon.alt}class="icon-card__icon">
							</figure>
						</article>
					</li>
				))}
			</ul>
			<Button theme="primary" href="/services" text="Learn More About What I Can Do" customClasses="skills__action"/>
		</Container>
	 </section>
</MainTemplate>