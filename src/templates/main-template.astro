---
// Component imports
import HeadTag from "./head-tag.astro";
import Header from "../components/header/index.astro";
import Footer from "../components/footer/index.astro";
import CtaParksville from "../components/frames/cta-parksville.astro";

interface Props {
    title: string;
    description?: string;
    author?: string;
    keywords?: string[];
    noCta?: boolean;
    noHeader?: boolean;
    noFooter?: boolean;
}
const { title, description, author, keywords, noCta = false , noHeader = false, noFooter = false} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<HeadTag {title} {description} {author} {keywords}/>
	<body>
        <a href="#main" class="skip">Skip to Main content</a>
        <a href="#footer" class="skip">Skip to footer</a>
    <main id="main">
        {!noHeader && <Header />}
        <slot />
        <!-- {!noCta && <CtaParksville /> } -->
        {!noFooter && <Footer />}
        <style is:global lang="scss">
            @import '../css/index.scss';
        </style>

        <script>
            import "../scripts/app.js";
        </script>
    </main>
	</body>
</html>