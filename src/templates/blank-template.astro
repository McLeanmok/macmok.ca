---
import { string } from 'astro:schema';
import HeadTag from "./head-tag.astro";
interface Props {
    title: string;
    description?: string;
    author?: string;
    keywords?: string[];

}
const {title, description, author, keywords} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<HeadTag {title} {description} {author} {keywords}/>
	<body>
    <main>
        <slot />
        <style is:global lang="scss">
            @import '../css/index.scss';
        </style>
    </main>
	</body>
</html>